<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">


        <record id="mail_template_application_confirmation"
                model="mail.template">

            <field name="name">Application Received</field>
            <field name="model_id" ref="model_recruitment_application"/>

            <field name="subject">We received your application for {{ object.job_id.name or '' }}</field>
            <field name="email_from">{{ user.email or 'noreply@example.com' }}</field>
            <field name="email_to">{{ object.email or '' }}</field>

            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; max-width: 600px; margin: auto;">

                    <h2 style="color: #0d6efd;">Application Received</h2>

                    <p>
                        Dear<t t-out="object.name or ''"/>,
                    </p>

                    <p>
                        Thank you for applying to the position of
                        <strong>
                            <t t-out="object.job_id.name or ''"/>
                        </strong>
                        .
                        We have received your application and our team
                        will review it shortly.
                    </p>

                    <p>
                        If your profile matches our needs, we will contact you
                        at this email address to schedule the next steps.
                    </p>

                    <hr style="border: none; border-top: 1px solid #ddd; margin: 20px 0;"/>

                    <p style="color: #888; font-size: 12px;">
                        Best regards,
                        <br/>
                        The Recruitment Team
                    </p>

                </div>
            </field>

            <field name="auto_delete" eval="True"/>

        </record>

    </data>
</odoo>
