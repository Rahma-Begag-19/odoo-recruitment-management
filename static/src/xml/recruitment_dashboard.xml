<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="recruitment_management.RecruitmentDashboard">
        <div class="o_recruitment_dashboard p-4">

            <h2 class="mb-4">Recruitment Pipeline</h2>

            <!-- Pipeline cards -->
            <div class="row g-3 mb-4">
                <div t-foreach="state.stages" t-as="stage" t-key="stage"
                     t-attf-class="col-12 col-md-3">
                    <div class="card shadow-sm h-100"
                         t-attf-style="border-top: 4px solid #{stage.color}; cursor: pointer;"
                         t-on-click="() => this.openStage(stage)">
                        <div class="card-body text-center">
                            <div t-attf-style="color: #{stage.color};"
                                 class="display-4 fw-bold">
                                <t t-out="stage.count"/>
                            </div>
                            <div class="text-muted mt-2">
                                <t t-out="stage.label"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Summary row -->
            <div class="row g-3">

                <div class="col-12 col-md-4">
                    <div class="card shadow-sm h-100"
                         style="cursor: pointer;"
                         t-on-click="openAllApplications">
                        <div class="card-body d-flex align-items-center">
                            <i class="fa fa-inbox fa-2x text-primary me-3"
                               title="Applications"/>
                            <div>
                                <div class="fs-4 fw-bold">
                                    <t t-out="state.total_applications"/>
                                </div>
                                <div class="text-muted">Total Applications</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-4">
                    <div class="card shadow-sm h-100"
                         style="cursor: pointer;"
                         t-on-click="() => this.openJobs('open')">
                        <div class="card-body d-flex align-items-center">
                            <i class="fa fa-briefcase fa-2x text-success me-3"
                               title="Open Jobs"/>
                            <div>
                                <div class="fs-4 fw-bold">
                                    <t t-out="state.open_jobs"/>
                                </div>
                                <div class="text-muted">Open Job Offers</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-4">
                    <div class="card shadow-sm h-100"
                         style="cursor: pointer;"
                         t-on-click="() => this.openJobs('closed')">
                        <div class="card-body d-flex align-items-center">
                            <i class="fa fa-archive fa-2x text-secondary me-3"
                               title="Closed Jobs"/>
                            <div>
                                <div class="fs-4 fw-bold">
                                    <t t-out="state.closed_jobs"/>
                                </div>
                                <div class="text-muted">Closed Job Offers</div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Applications over time chart -->
            <div class="card shadow-sm mt-4">
                <div class="card-body">
                    <h5 class="card-title mb-3">Applications Over Time</h5>
                    <div style="height: 300px;">
                        <canvas t-ref="applicationsChart"/>
                    </div>
                </div>
            </div>

        </div>
    </t>

</templates>