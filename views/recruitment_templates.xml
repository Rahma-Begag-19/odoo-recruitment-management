<?xml version="1.0" encoding="UTF-8"?>
<odoo>


    <!-- Thank you page -->
    <template id="careers_thank_you" name="Application Received">
        <t t-call="website.layout">
            <section class="py-5">
                <div class="container text-center py-5">
                    <i class="fa fa-check-circle fa-5x text-success mb-4"/>
                    <h1>Application Received</h1>
                    <p class="lead text-muted">
                        Thank you for applying! Our team will review your
                        application and get back to you soon.
                    </p>
                    <a href="/careers" class="btn btn-primary mt-3">
                        Back to Careers
                    </a>
                </div>
            </section>
        </t>
    </template>

    <!-- Application modal (rendered once per job, inside the job loop) -->
    <template id="application_modal" name="Application Modal">
        <div class="modal fade"
             t-att-id="'applyModal%s' % job.id"
             tabindex="-1"
             aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title h5">
                            Apply for
                            <t t-out="job.name"/>
                        </h2>
                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close"/>
                    </div>

                    <form action="/careers/apply"
                          method="post"
                          enctype="multipart/form-data">
                        <div class="modal-body">
                            <input type="hidden"
                                   name="csrf_token"
                                   t-att-value="request.csrf_token()"/>
                            <input type="hidden"
                                   name="job_id"
                                   t-att-value="job.id"/>

                            <!-- Honeypot (anti-spam, invisible to humans) -->
                            <div class="d-none">
                                <input type="text"
                                       name="website"
                                       value=""
                                       autocomplete="off"
                                       tabindex="-1"/>
                            </div>

                            <!-- Two-column layout -->
                            <div class="row g-3">

                                <!-- LEFT COLUMN -->
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">Full Name *</label>
                                        <input type="text"
                                               name="candidate_name"
                                               class="form-control"
                                               maxlength="200"
                                               required="required"/>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Email *</label>
                                        <input type="email"
                                               name="email"
                                               class="form-control"
                                               maxlength="254"
                                               required="required"/>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Phone</label>
                                        <input type="tel"
                                               name="phone"
                                               class="form-control"
                                               maxlength="50"/>
                                    </div>

                                    <div class="mb-3 mb-md-0">
                                        <label class="form-label">Gender</label>
                                        <select name="gender" class="form-select">
                                            <option value="">Prefer not to say</option>
                                            <option value="male">Male</option>
                                            <option value="female">Female</option>
                                        </select>
                                    </div>
                                </div>

                                <!-- RIGHT COLUMN -->
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">Location</label>
                                        <input type="text"
                                               name="location"
                                               class="form-control"
                                               maxlength="200"/>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Notes / Cover Letter</label>
                                        <textarea name="note"
                                                  class="form-control"
                                                  rows="4"
                                                  maxlength="10000"/>
                                    </div>

                                    <div class="mb-0">
                                        <label class="form-label">CV / Resume *</label>
                                        <input type="file"
                                               name="resume"
                                               class="form-control"
                                               accept=".pdf,.doc,.docx"
                                               required="required"/>
                                        <small class="text-muted">
                                            PDF, DOC, or DOCX; maximum 5 MB.
                                        </small>
                                    </div>
                                </div>

                            </div>
                        </div>

                        <div class="modal-footer">
                            <button type="button"
                                    class="btn btn-secondary"
                                    data-bs-dismiss="modal">
                                Cancel
                            </button>
                            <button type="submit"
                                    class="btn btn-primary">
                                Submit Application
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </template>
    <!-- Careers list page -->
    <template id="website_recruitment_jobs" name="Job Offers">
        <t t-call="website.layout">
            <!-- Hero -->
            <section class="py-5 bg-primary text-white text-center">
                <div class="container">
                    <h1 class="display-4 fw-bold">Join Our Team</h1>
                    <p class="lead mt-3">We're building something great — and we'd love your help.</p>
                    <a href="#open-positions" class="btn btn-light btn-lg mt-3">See Open Positions</a>
                </div>
            </section>

            <!-- Why work with us -->
            <section class="py-5">
                <div class="container">
                    <div class="row text-center g-4">
                        <div class="col-md-4">
                            <i class="fa fa-rocket fa-3x text-primary mb-3"/>
                            <h4>Grow Fast</h4>
                            <p>Real responsibility from day one, with mentorship to match.</p>
                        </div>
                        <div class="col-md-4">
                            <i class="fa fa-heart fa-3x text-primary mb-3"/>
                            <h4>Great Culture</h4>
                            <p>A supportive team that celebrates wins, big and small.</p>
                        </div>
                        <div class="col-md-4">
                            <i class="fa fa-balance-scale fa-3x text-primary mb-3"/>
                            <h4>Work-Life Balance</h4>
                            <p>Flexible hours and remote-friendly policies.</p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Open positions -->
            <section id="open-positions" class="py-5 bg-light">
                <div class="container">
                    <h2 class="text-center mb-5">Open Positions</h2>

                    <div t-if="jobs" class="row g-4">
                        <div t-foreach="jobs" t-as="job"
                             class="col-md-6 col-lg-4">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body">
                                    <h2 class="h5 card-title">
                                        <t t-out="job.name"/>
                                    </h2>

                                    <p class="text-muted small">
                                        <i class="fa fa-map-marker me-2"/>
                                        <t t-out="job.place"/>
                                    </p>

                                    <p>
                                        <strong>Work mode:</strong>
                                        <t t-out="dict(job._fields['work_mode'].selection).get(job.work_mode, '')"/>
                                    </p>

                                    <p>
                                        <strong>Level:</strong>
                                        <t t-out="dict(job._fields['level'].selection).get(job.level, '')"/>
                                    </p>

                                    <p t-if="job.salary">
                                        <strong>Salary:</strong>
                                        <span t-field="job.salary"/>
                                    </p>

                                    <p t-if="job.experience">
                                        <strong>Experience:</strong>
                                        <t t-out="', '.join(job.experience.mapped('name'))"/>
                                    </p>

                                    <p t-if="job.description"
                                       class="text-muted">
                                        <t t-out="job.description"/>
                                    </p>

                                    <p class="small text-muted"
                                       t-if="job.expiration_date">
                                        Apply before:
                                        <span t-field="job.expiration_date"/>
                                    </p>
                                </div>

                                <div class="card-footer bg-white border-0">
                                    <div class="d-flex gap-2 flex-wrap">
                                        <a t-att-href="'/careers/job/%s' % job.id"
                                           class="btn btn-outline-primary">
                                            More Details
                                        </a>

                                        <button type="button"
                                                class="btn btn-primary"
                                                data-bs-toggle="modal"
                                                t-att-data-bs-target="'#applyModal%s' % job.id">
                                            Apply Now
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- One modal per job — THIS is what makes the
                                 card's Apply button work -->
                            <t t-call="recruitment_management.application_modal"/>
                        </div>
                    </div>

                    <div t-else="" class="text-center text-muted">
                        <p>No open positions right now — but feel free to send your CV to
                            <a href="mailto:rahmabegag19@gmail.com">rahmabegag19@gmail.com</a>.
                        </p>
                    </div>
                </div>
            </section>

            <div class="oe_structure"/>
        </t>
    </template>

    <!-- Job detail page -->
    <template id="careers_job_detail" name="Job Details">
        <t t-call="website.layout">
            <div id="wrap">
                <section class="py-5">
                    <div class="container">
                        <a href="/careers" class="btn btn-link px-0">
                            ← All Open Positions
                        </a>

                        <div t-if="error" class="alert alert-danger mt-3">
                            <t t-if="error == 'invalid'">Please check the form fields and try again.</t>
                            <t t-elif="error == 'resume'">Invalid resume file. Use PDF/DOC/DOCX, max 5 MB.</t>
                            <t t-else="">Something went wrong. Please try again later.</t>
                        </div>

                        <h1 t-out="job.name" class="mt-3"/>

                        <p class="text-muted">
                            <t t-out="job.place"/>
                            ·
                            <t t-out="dict(job._fields['work_mode'].selection).get(job.work_mode, '')"/>
                            ·
                            <t t-out="dict(job._fields['level'].selection).get(job.level, '')"/>
                        </p>

                        <div class="row mt-4">
                            <div class="col-lg-8">
                                <div t-if="job.description"
                                     t-field="job.description"/>
                                <p t-else="">No description has been provided yet.</p>

                                <h3 t-if="job.experience" class="mt-4">
                                    Required Experience
                                </h3>
                                <ul t-if="job.experience">
                                    <li t-foreach="job.experience"
                                        t-as="experience">
                                        <t t-out="experience.name"/>
                                    </li>
                                </ul>
                            </div>

                            <div class="col-lg-4">
                                <div class="card shadow-sm">
                                    <div class="card-body">
                                        <p t-if="job.salary">
                                            <strong>Salary:</strong>
                                            <span t-field="job.salary"/>
                                        </p>
                                        <p t-if="job.expiration_date">
                                            <strong>Deadline:</strong>
                                            <span t-field="job.expiration_date"/>
                                        </p>
                                        <button type="button"
                                                class="btn btn-primary w-100"
                                                data-bs-toggle="modal"
                                                t-att-data-bs-target="'#applyModal%s' % job.id">
                                            Apply Now
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <t t-call="recruitment_management.application_modal"/>
                    </div>
                </section>
            </div>
        </t>
    </template>

</odoo>